{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/", "destination": "/frontend/public/index.html" },
    { "source": "/(.*)", "destination": "/frontend/public/$1" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "artifacts/*.json,model/*.json"
    }
  }
}
